    {
      "id": "KN-02 T02",
      "kind": "正常 zh",
      "mode": "chat",
      "inputs": {},
      "query": "冲床 PX-200 出现报警 E-47 停机了，该怎么处理？",
      "expect": ["7-12", ["滑块下死点位置偏差检测", "位置偏差"], "急停", ["ORG", "原点复归"], "保全科长"],
