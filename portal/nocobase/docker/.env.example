# portal/nocobase/docker/.env.example — docker-compose.yml が参照する変数名の一覧。値は入れない。
#
# 実際の値は ~/.config/portal/<env>.env に置き、`docker compose --env-file <path> up -d` で渡す
# （shoulang0729/dify CLAUDE.md §2-10 の作法と同じ）。

# ---- PostgreSQL ----
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# ---- NocoBase ----
APP_KEY=
APP_PORT=

# ---- G-1〜G-3（方式 (a) の歯止め。初日に決めて以後変更しない。portal/schema/README.md 参照） ----
# ★ 直値で固定（環境ごとに変えない。変えると DB の作り直しになる）
DB_UNDERSCORED=true
DB_TABLE_PREFIX=nb_
