# .env.example — 変数名の一覧。値は 1 つも入れない（実際の値はリポジトリの外、
# ~/.config/portal/<env>.env に置く）。
#
# 設計書: shoulang0729/dify docs/handoff/2026-09-10-portal-nocobase.md §7-6・
# docs/handoff/2026-09-11-repo-layout-v3.md §2-4。
# ここに 1 つでも実際の値・実名・実 URL を書かない（tools/check-nodata.mjs の N4/N5/N6・G4 が検査する）。

# ---- 秘密（漏れると事故） ----
# 人事・勤怠・研修（LMS）システムへの読み取り専用接続（データソース名は `hr` に固定）
PORTAL_DSN_HR=

# SSO（OIDC）のクライアント資格情報。当面未使用（NocoBase Community は SSO/OIDC/LDAP/SAML 非対応。
# docs/handoff/2026-09-10-portal-nocobase.md rev3 §0-2 D-1・§4-4b・R-0【1】・A13：Professional+ を
# 購入する日まで、本番もローカルユーザー認証のまま）。変数名だけ予約しておき、値は入れない
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=

# Dify Service API キー（アプリ単位・管理番号で命名）
# 例: DIFY_API_KEY_KN01=
# 例: DIFY_API_KEY_DC01=

# NocoBase 本体（値は nocobase/docker/.env.example にも変数名だけ重複して書く。G-1〜G-3 は固定値なので
# .env.example ではなく schema/README.md・nocobase/docker/.env.example に直値で書く）
PORTAL_APP_KEY=
PORTAL_DB_PASSWORD=

# ---- 秘密ではないが公開したくない値 ----
# 年休取得率の通知閾値・残業の警告時間
PORTAL_THRESHOLD_LEAVE_RATE=
PORTAL_THRESHOLD_OVERTIME_HOURS=

# 所定労働時間・締め日
PORTAL_WORKHOURS_STD=
PORTAL_CLOSING_DAY=
