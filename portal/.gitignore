*.dump
*.bak
*.xlsx
*.db
*.sqlite

# schema/**（Flyway の DDL）は上の *.sql に引っかかるので明示的に許可する
!schema/*.sql

# ---- Node（S-2：portal/ は独立 npm プロジェクト） ----
node_modules/
