# Dify 接続設定の雛形（値は空。実際の値は commit しない。CLAUDE.md §2-10 / §2-12）
# 使い方: 環境ごとに 1 ファイル、リポジトリの外にコピーして使う
#   mkdir -p ~/.config/dify && cp scripts/dify/env.example ~/.config/dify/<env>.env
#   ~/.config/dify/<env>.env を編集して値を入れたら
#   export DIFY_ENV=<env>; set -a; source ~/.config/dify/$DIFY_ENV.env; set +a

# 既定 cloud-master。--env 未指定時の既定になる
DIFY_ENV=cloud-master

# Service/Datasets API の基点（env.yml の ${DIFY_BASE_URL} にも展開される）
DIFY_BASE_URL=https://api.dify.ai/v1
# Console API の基点（未設定なら env.yml の dify.console_url。cloud-master は https://cloud.dify.ai）
DIFY_CONSOLE_URL=
# Console API の Cookie 認証（Cloud。Issue #121 W4-3）。保存するのはリフレッシュトークン 1 個だけ。
# 取り方: Chrome で Dify Cloud にログイン → 開発者ツール → Application → Cookies →
# https://cloud.dify.ai → __Host-refresh_token の Value をコピー → ここに貼る。
# **値をチャット・ログ・Issue・結果ファイルに貼らない**（CLAUDE.md §2-10）。手順の詳細: dify/DEPLOY.md §9
# set なら console_api.py / cloud_deploy.py が自動でこれを使う（1 回使うと rotate されるため、
# 投入する回ごとに取り直す運用になる。§8-3）
DIFY_CONSOLE_REFRESH=
# 【非推奨】旧トークン認証（1.17.0 の Cloud には console_token が存在しないため使えない。G5）。
# 互換のため読み込みはするが、新規は DIFY_CONSOLE_REFRESH を使うこと
DIFY_CONSOLE_TOKEN=
# Console API ログイン（selfhost のみ。cloud では使わない）
DIFY_CONSOLE_EMAIL=
DIFY_CONSOLE_PASSWORD=

# ナレッジ API キー（Studio → ナレッジ → API → API キー）
DIFY_DATASET_KEY=

# アプリごとの Service API キー（アプリ → API アクセス → API キー）。管理番号のハイフンを除いた名前
DIFY_APP_KEY_KN01=
DIFY_APP_KEY_DC01=
# 第 2 弾（提供中 10 件、Issue #98）
DIFY_APP_KEY_KN02=
DIFY_APP_KEY_KN03=
DIFY_APP_KEY_NM03=
DIFY_APP_KEY_GN05=
DIFY_APP_KEY_DC02=
DIFY_APP_KEY_DC04=
DIFY_APP_KEY_GN01=
DIFY_APP_KEY_GN02=
DIFY_APP_KEY_LG01=
DIFY_APP_KEY_LG04=

# knowledge.*.id の ${VAR} 展開用（任意。顧客環境で採番された dataset id）
DIFY_DATASET_ID_KN01=
DIFY_DATASET_ID_KN02=
DIFY_DATASET_ID_KN03=
DIFY_DATASET_ID_GN01=

# apps.<番号>.id の ${VAR} 展開用（顧客・社内 env のみ。cloud-master は env.yml に直値か null を書く。
# CLAUDE.md §2-10：顧客環境で採番された Cloud のアプリ id をリポジトリに直値で書かない）
DIFY_APP_ID_KN01=
DIFY_APP_ID_KN02=
DIFY_APP_ID_KN03=
DIFY_APP_ID_DC01=
DIFY_APP_ID_DC02=
DIFY_APP_ID_DC04=
DIFY_APP_ID_GN01=
DIFY_APP_ID_GN02=
DIFY_APP_ID_GN05=
DIFY_APP_ID_LG01=
DIFY_APP_ID_LG04=
DIFY_APP_ID_NM03=

# 環境での KB 名が架空名と違う場合（顧客環境）
KB_NAME_KN01=
KB_NAME_KN02=
KB_NAME_KN03=
KB_NAME_GN01=

# ブランド語彙（顧客環境のみ。実名はリポジトリに書かない）
BRAND_COMPANY_JA=
BRAND_COMPANY_ZH=
BRAND_COMPANY_EN=
BRAND_ENTITY_JA=
BRAND_ENTITY_ZH=
BRAND_ENTITY_EN=
BRAND_SITE1_JA=
BRAND_SITE1_ZH=
BRAND_SITE1_EN=
BRAND_SITE2_JA=
BRAND_SITE2_ZH=
BRAND_SITE2_EN=

# 越境ゼロ帯の自前モデル名（DP-03。任意）
LOCAL_MODEL_NAME=

# 社内セルフホスト（inhouse）の Ollama モデル名。実機に入っているモデル名を入れる（未確認）
INHOUSE_CHAT_MODEL=
INHOUSE_REASON_MODEL=
INHOUSE_SMALL_MODEL=
INHOUSE_EMBED_MODEL=
