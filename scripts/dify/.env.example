# Dify Cloud への接続設定（値は空。実際の値は commit しない。CLAUDE.md §2-10）
# 使い方: リポジトリの外にコピーして使う（.gitignore は .env を除外していない）
#   mkdir -p ~/.config/dify && cp scripts/dify/.env.example ~/.config/dify/env && 値を埋めて `set -a; source ~/.config/dify/env; set +a`
DIFY_BASE_URL=https://api.dify.ai/v1
# ナレッジ API キー（Studio → ナレッジ → API → API キー）
DIFY_DATASET_KEY=
# アプリごとの Service API キー（アプリ → API アクセス → API キー）。管理番号のハイフンを除いた名前
DIFY_APP_KEY_KN01=
DIFY_APP_KEY_DC01=
